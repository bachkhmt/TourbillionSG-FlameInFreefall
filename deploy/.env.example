# Copy to deploy/.env (ignored). Local disposable demo only, never cloud credentials.
# Use distinct random URL-safe passwords (letters/digits); do not leave placeholders.
POSTGRES_PASSWORD=CHANGE_ME_ADMIN
OWNER_PASSWORD=CHANGE_ME_OWNER
READER_PASSWORD=CHANGE_ME_READER
BACKEND_IMAGE=flameguard-api:local
FRONTEND_IMAGE=flameguard-web:local
FRONTEND_PORT=3000
BACKEND_PORT=8000
# For VM override only: DNS pointing to VM; Caddy obtains a public certificate.
DEMO_DOMAIN=demo.example.org
ACME_EMAIL=admin@example.org
