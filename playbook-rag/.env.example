# Không có khóa thì chạy chế độ retrieval-only (vẫn đầy đủ trích dẫn).
ANTHROPIC_API_KEY=
RAG_LLM_MODEL=claude-sonnet-5-5
RAG_TIMEOUT_S=15
RAG_RATE_LIMIT=20
RAG_TOP_K=6
# hash (mặc định, không cần mạng) | st:<tên-mô-hình> | để trống = tắt vector
RAG_EMBEDDER=hash
# Đặt 1 để ép chạy offline kể cả khi có khóa
RAG_OFFLINE=0
