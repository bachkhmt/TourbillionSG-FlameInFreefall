# Without a key, runs in retrieval-only mode (still with full citations).
ANTHROPIC_API_KEY=
RAG_LLM_MODEL=claude-sonnet-5-5
RAG_TIMEOUT_S=15
RAG_RATE_LIMIT=20
RAG_TOP_K=6
# hash (default, no network needed) | st:<model-name> | leave empty = disable vector
RAG_EMBEDDER=hash
# Set to 1 to force offline mode even with an API key
RAG_OFFLINE=0
